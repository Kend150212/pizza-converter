{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "settings",
        "title": "Pizza Converter",
        "url": "settings.html",
        "width": 780,
        "height": 872,
        "resizable": false,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "label": "radial",
        "title": "Pizza Converter Radial",
        "url": "index.html",
        "width": 560,
        "height": 560,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "hud",
        "title": "Pizza Converter HUD",
        "url": "hud.html",
        "width": 344,
        "height": 130,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "targets": [
      "msi",
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "identifier": "NeelFlow.PizzaConverter",
  "productName": "Pizza Converter",
  "version": "0.1.0"
}
