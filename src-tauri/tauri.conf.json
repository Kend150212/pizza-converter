{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "settings",
        "title": "Pizza Converter",
        "url": "settings.html",
        "width": 1280,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "label": "radial",
        "title": "Pizza Converter Radial",
        "url": "index.html",
        "width": 560,
        "height": 560,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "hud",
        "title": "Pizza Converter HUD",
        "url": "hud.html",
        "width": 272,
        "height": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "targets": [
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "identifier": "NeelFlow.PizzaConverter",
  "productName": "Pizza Converter",
  "version": "1.0.6"
}
